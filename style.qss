QWidget#leftPanel {
        background-color: rgba(30, 32, 38, 215);
	border-radius: 10px;
	border: 1px solid rgba(255, 255, 255, 40);
}

QGroupBox {
        font-weight: bold;
	color: #E6E6E6;
	border: 1px solid rgba(255, 255, 255, 30);
	border-radius: 6px;
	margin-top: 8px;
	padding-top: 10px;
}

QGroupBox::title {
        subcontrol-origin: margin;
	subcontrol-position: top left;
	left: 10px;
	padding: 0 4px;
	color: #FFFFFF;
}

QLabel {
        color: #DDDDDD;
	font-size: 12px;
}

QPushButton {
        background-color: rgba(60, 65, 78, 220);
	color: #FFFFFF;
	border: 1px solid rgba(255, 255, 255, 45);
	border-radius: 4px;
	padding: 6px;
	font-weight: 500;
}

QPushButton:hover {
        background-color: rgba(85, 92, 110, 240);
}

QPushButton:pressed {
        background-color: rgba(40, 44, 52, 250);
}

QSlider::groove:horizontal {
    border: 1px solid rgba(255, 255, 255, 30);
    height: 6px;
    background: rgba(20, 22, 26, 200);
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #4A90E2;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #FFFFFF;
    border: 1px solid #4A90E2;
    width: 14px;
    height: 14px;
    margin: -4px 0;
    border-radius: 7px;
}

QSlider::handle:horizontal:hover {
    background: #ECECEC;
}

QSpinBox, QDoubleSpinBox {
    background-color: rgba(20, 22, 26, 200);
    color: #FFFFFF;
    border: 1px solid rgba(255, 255, 255, 40);
    border-radius: 4px;
    padding: 2px 4px;
    font-size: 12px;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 14px;
    background: rgba(60, 65, 78, 180);
    border: none;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(85, 92, 110, 220);
}